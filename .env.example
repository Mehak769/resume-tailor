# LLM API configuration
# LiteLLM supports any standard model format, for example:
# openrouter/meta-llama/llama-3.3-70b-instruct:free, openai/gpt-4o-mini, anthropic/claude-3-5-sonnet
LLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free

# Set the API key for your chosen provider:
OPENROUTER_API_KEY=your-openrouter-key-here
# OPENAI_API_KEY=your-api-key-here
# ANTHROPIC_API_KEY=your-api-key-here
# GEMINI_API_KEY=your-api-key-here

# Application configuration
LOG_LEVEL=INFO
LLM_TEMPERATURE=0.2
DEFAULT_OUTPUT_DIR=./applications
